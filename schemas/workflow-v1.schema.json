{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptflow-os.dev/schema/workflow/v1",
  "title": "Promptflow OS workflow v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "status", "inputs", "outputs", "nodes", "edges", "error_policy"],
  "properties": {
    "schema": {"const": "workflow/v1"},
    "id": {"type": "string", "pattern": "^workflow:[A-Za-z0-9_-]{6,80}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 240},
    "description": {"type": "string", "maxLength": 4000},
    "status": {"type": "string", "enum": ["draft", "active", "experimental", "deprecated", "archived", "invalid"]},
    "inputs": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/portSchema"}
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/portSchema"}
    },
    "variables": {
      "type": "array",
      "items": {"$ref": "#/$defs/variable"}
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    },
    "error_policy": {"$ref": "#/$defs/errorPolicy"},
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "pattern": "^(prompt|context|instruction|template|reference|evaluation|test|workflow|asset):[A-Za-z0-9_-]{6,80}$"
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required", "secret"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"},
        "type": {"type": "string", "enum": ["string", "number", "integer", "boolean", "object", "array", "json"]},
        "required": {"type": "boolean"},
        "secret": {"type": "boolean"},
        "default": {},
        "description": {"type": "string", "maxLength": 1000}
      }
    },
    "portSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "enum": ["string", "number", "integer", "boolean", "object", "array", "json"]},
        "required": {"type": "boolean", "default": false},
        "secret": {"type": "boolean", "default": false},
        "description": {"type": "string", "maxLength": 1000}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "inputs", "outputs"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
        "type": {"type": "string", "enum": ["input", "prompt", "transform", "branch", "evaluate", "loop", "approval", "output", "subflow"]},
        "label": {"type": "string", "maxLength": 160},
        "ref": {"$ref": "#/$defs/ref"},
        "inputs": {"type": "object", "additionalProperties": {"type": "string", "maxLength": 2000}},
        "outputs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/portSchema"}},
        "config": {"type": "object", "additionalProperties": true},
        "loop": {"$ref": "#/$defs/loopPolicy"},
        "retry": {"$ref": "#/$defs/retryPolicy"},
        "approval": {"$ref": "#/$defs/approvalPolicy"}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "prompt"}}},
          "then": {"required": ["ref"]}
        },
        {
          "if": {"properties": {"type": {"const": "evaluate"}}},
          "then": {"required": ["ref"]}
        },
        {
          "if": {"properties": {"type": {"const": "subflow"}}},
          "then": {"required": ["ref"]}
        },
        {
          "if": {"properties": {"type": {"const": "loop"}}},
          "then": {"required": ["loop"]}
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]{1,160}$"},
        "to": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]{1,160}$"},
        "when": {"type": "string", "maxLength": 2000},
        "transform": {"type": "string", "maxLength": 2000}
      }
    },
    "loopPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body", "max_iterations", "on_exhaustion"],
      "properties": {
        "body": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"}},
        "stop_when": {"type": "string", "maxLength": 2000},
        "max_iterations": {"type": "integer", "minimum": 1, "maximum": 100},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "max_provider_calls": {"type": "integer", "minimum": 1, "maximum": 1000},
        "on_exhaustion": {"type": "string", "enum": ["fail", "needs_review", "accept_last"]}
      },
      "anyOf": [{"required": ["stop_when"]}, {"required": ["timeout_seconds"]}]
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10, "default": 1},
        "backoff_seconds": {"type": "number", "minimum": 0, "maximum": 3600},
        "retry_on": {"type": "array", "items": {"type": "string", "enum": ["timeout", "rate_limit", "transient", "provider_unavailable"]}}
      }
    },
    "approvalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "on_reject"],
      "properties": {
        "required": {"type": "boolean"},
        "approver_label": {"type": "string", "maxLength": 160},
        "on_reject": {"type": "string", "enum": ["fail", "return_to_loop", "needs_review"]}
      }
    },
    "errorPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on_unhandled_error", "max_total_provider_calls"],
      "properties": {
        "on_unhandled_error": {"type": "string", "enum": ["fail", "needs_review"]},
        "max_total_provider_calls": {"type": "integer", "minimum": 1, "maximum": 10000},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 604800}
      }
    }
  }
}
